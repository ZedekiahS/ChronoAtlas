        }
      ]
    },
    {
      "nodeKey": "zztj-kaoyi-v3-wei-wudi-quote",
      "parentKey": "zztj-kaoyi-v3-hefei-heading",
      "nodeType": "quoted_fragment",
      "ordinal": 2,
      "label": "《魏志·武帝纪》所载合肥与赤壁先后",
      "locatorPath": "卷3/漢紀下/建安十三年/十二月孫權圍合肥/引魏志武帝紀",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af001",
        "type": "explicit_citation",
        "text": "魏志武紀",
        "certainty": "high"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "十二月，權爲備攻合肥。公自江陵征備，至巴丘，遣張熹救合肥。權聞憙至，乃走。公至赤壁，與備戰，不利。"
        }
      ]
    },
    {
      "nodeKey": "zztj-kaoyi-v3-sunsheng-quote",
      "parentKey": "zztj-kaoyi-v3-hefei-heading",
      "nodeType": "quoted_fragment",
      "ordinal": 3,
      "label": "孙盛《异同评》判定吴志时序为是",
      "locatorPath": "卷3/漢紀下/建安十三年/十二月孫權圍合肥/引孫盛異同評",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af023",
        "type": "explicit_citation",
        "text": "孫盛異同評曰",
        "certainty": "high"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "按吳志，備先破公軍，然後權攻合肥，而此紀云先攻合肥，後有赤壁之事。二者不同，吳志爲是。"
        }
      ]
    }
  ]
