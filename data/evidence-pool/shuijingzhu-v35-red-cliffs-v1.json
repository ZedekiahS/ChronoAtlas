    {
      "nodeKey": "sjz-v35-gongan",
      "parentKey": "sjz-v35-jiangshui",
      "nodeType": "passage",
      "ordinal": 1,
      "label": "公安筑镇与曹操闻借荆州落笔",
      "locatorPath": "卷35/江水/公安縣北",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "又東，右合油口，又東逕公安縣北，劉備之奔江陵，使築而鎮之。曹公聞孫權以荊州借備，臨書落筆。"
        }
      ]
    },
    {
      "nodeKey": "sjz-v35-three-wulin",
      "parentKey": "sjz-v35-jiangshui",
      "nodeType": "passage",
      "ordinal": 2,
      "label": "上乌林、中乌林、下乌林与黄盖败魏武",
      "locatorPath": "卷35/江水/上中下烏林",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "江水左逕上烏林南，村居地名也。又東逕烏黎口，江浦也，即中烏林矣。又東逕下烏林南，吳黃蓋敗魏武于烏林，即是處也。"
        }
      ]
    },
    {
      "nodeKey": "sjz-v35-red-cliffs-mountain",
      "parentKey": "sjz-v35-jiangshui",
      "nodeType": "passage",
      "ordinal": 3,
      "label": "百人山与赤壁山之间的战事记忆",
      "locatorPath": "卷35/江水/赤壁山北",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "江水左逕百人山南，右逕赤壁山北，昔周瑜與黃蓋詐魏武大軍處所也。"
        }
      ]
    },
    {
      "nodeKey": "sjz-v35-huangjunpu",
      "parentKey": "sjz-v35-jiangshui",
      "nodeType": "passage",
      "ordinal": 4,
      "label": "黄军浦与黄盖屯军记忆",
      "locatorPath": "卷35/江水/黃軍浦",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "直鸚鵡洲之下尾，江水溠曰洑浦，是曰黃軍浦。昔吳將黃蓋軍師所屯，故浦得其名，亦商舟之所會矣。"
        }
      ]
    }
  ]
