      "label": "《英雄记》曹军竹排与周瑜夜焚",
      "locatorPath": "卷771/舟部四/筏/英雄記曰",
      "layerRole": "quoted_fragment",
      "sourceUri": "https://zh.wikisource.org/wiki/%E5%A4%AA%E5%B9%B3%E5%BE%A1%E8%A6%BD/0771#%E7%AD%8F",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af018",
        "type": "explicit_citation",
        "text": "《英雄記》曰",
        "certainty": "high"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "曹操進軍至江上，欲從赤璧渡江。無船，作竹排，使部曲乘之。從漢水來下，出大江，注浦口，未即渡。周瑜又夜密使輕船走舸百艘燒排，操乃夜走。"
        }
      ]
    }
  ]
