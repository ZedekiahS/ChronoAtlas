    },
    {
      "nodeKey": "sgz-v54-zhou-yu",
      "parentKey": "sgz-v54",
      "nodeType": "biography",
      "ordinal": 1,
      "label": "吳書·周瑜傳",
      "locatorPath": "卷54/周瑜傳",
      "layerRole": "structure"
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-decision-main",
      "parentKey": "sgz-v54-zhou-yu",
      "nodeType": "passage",
      "ordinal": 1,
      "label": "建安十三年孙权集团议曹",
      "locatorPath": "卷54/周瑜傳/段1",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "十三年春，權討江夏，瑜為前部大督。其年九月，曹公入荊州，劉琮舉眾降，曹公得其水軍，船步兵數十萬，將士聞之皆恐。權延見群下，問以計策。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-surrender-argument",
      "parentKey": "sgz-v54-zhou-yu",
      "nodeType": "passage",
      "ordinal": 8,
      "label": "群臣陈说迎曹理由",
      "locatorPath": "卷54/周瑜傳/建安十三年/迎曹議",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "議者咸曰：「曹公豺虎也，然託名漢相，挾天子以征四方，動以朝廷為辭，今日拒之，事更不順。且將軍大勢可以拒操者，長江也。今操得荊州，奄有其地。劉表治水軍，蒙衝鬥艦，乃以千數，操悉浮以沿江，兼有步兵，水陸俱下。此為長江之險，已與我共之矣。而勢力眾寡，又不可論。愚謂大計不如迎之。」"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-reject-cao-analysis",
      "parentKey": "sgz-v54-zhou-yu",
      "nodeType": "passage",
      "ordinal": 9,
      "label": "周瑜分析曹军用兵四患",
      "locatorPath": "卷54/周瑜傳/建安十三年/周瑜拒曹議",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "瑜曰：「不然。操雖託名漢相，其實漢賊也。將軍以神武雄才，兼仗父兄之烈，割據江東，地方數千里，兵精足用，英雄樂業，尚當橫行天下，為漢家除殘去穢。況操自送死，而可迎之邪？請為將軍籌之：今使北土已安，操無內憂，能曠日持久，來爭疆場，又能與我校勝負於船楫，可乎？今北土既未平安，加馬超、韓遂尚在關西，為操後患。且舍鞍馬，仗舟楫，與吳越爭衡，本非中國所長。又今盛寒，馬無蒿草。驅中國士眾遠涉江湖之間，不習水土，必生疾病。此數四者，用兵之患也，而操皆冒行之。將軍禽操，宜在今日。瑜請得精兵三萬人，進住夏口，保為將軍破之。」"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-sun-quan-decision",
      "parentKey": "sgz-v54-zhou-yu",
      "nodeType": "passage",
      "ordinal": 10,
      "label": "孙权确认拒曹决策",
      "locatorPath": "卷54/周瑜傳/建安十三年/孫權定策",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "權曰：「老賊欲廢漢自立久矣，徒忌二袁、呂布、劉表與孤耳。今數雄已滅，惟孤尚存，孤與老賊，勢不兩立。君言當擊，甚與孤合，此天以君授孤也。」"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-jiangbiao-night-council",
      "parentKey": "sgz-v54-zhou-yu-sun-quan-decision",
      "nodeType": "quoted_fragment",
      "ordinal": 11,
      "label": "裴注引《江表传》斫案与夜议兵力",
      "locatorPath": "卷54/周瑜傳/建安十三年/裴注引江表傳/斫案夜議",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af002",
        "type": "explicit_citation",
        "text": "《江表傳》曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "權拔刀斫前奏案曰：「諸將吏敢復有言當迎操者，與此案同！」及會罷之夜，瑜請見曰：「諸人徒見操書，言水步八十萬，而各恐懾，不復料其虛實，便開此議，甚無謂也。今以實校之，彼所將中國人，不過十五六萬，且軍已久疲，所得表眾，亦極七八萬耳，尚懷狐疑。夫以疲病之卒，御狐疑之眾，眾數雖多，甚未足畏。得精兵五萬，自足制之，願將軍勿慮。」權撫背曰：「公瑾，卿言至此，甚合孤心。子布、文表諸人，各顧妻子，挾持私慮，深失所望，獨卿與子敬與孤同耳，此天以卿二人贊孤也。五萬兵難卒合，已選三萬人，船糧戰具俱辦，卿與子敬、程公便在前發，孤當續發人眾，多載資糧，為卿後援。卿能辦之者誠決，邂逅不如意，便還就孤，孤當與孟德決之。」"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-pei-comment",
      "parentKey": "sgz-v54-zhou-yu-decision-main",
      "nodeType": "commentary",
      "ordinal": 2,
      "label": "裴松之按鲁肃首倡拒曹",
      "locatorPath": "卷54/周瑜傳/段1/裴注1",
      "layerRole": "commentary",
      "layers": [
        {
          "kind": "commentary",
          "language": "lzh",
          "script": "Hant",
          "text": "臣松之以為建計拒曹公，實始魯肅。於時周瑜使鄱陽，肅勸權呼瑜，瑜使鄱陽還，但與肅闇同，故能共成大勳。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-alliance-main",
      "parentKey": "sgz-v54-zhou-yu",
      "nodeType": "passage",
      "ordinal": 3,
      "label": "鲁肃接触、诸葛亮出使与联合出兵",
      "locatorPath": "卷54/周瑜傳/段2",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "時劉備為曹公所破，欲引南渡江。與魯肅遇於當陽，遂共圖計，因進住夏口，遣諸葛亮詣權。權遂遣瑜及程普等與備並力逆曹公，遇於赤壁。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-battle-main",
      "parentKey": "sgz-v54-zhou-yu",
      "nodeType": "passage",
      "ordinal": 4,
      "label": "疾病、初战与火攻决策",
      "locatorPath": "卷54/周瑜傳/段3",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "時曹公軍眾已有疾病，初一交戰，公軍敗退，引次江北。瑜等在南岸。瑜部將黃蓋曰：今寇眾我寡，難與持久。然觀操軍船艦，首尾相接，可燒而走也。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-fire-attack-preparation-main",
      "parentKey": "sgz-v54-zhou-yu",
      "nodeType": "passage",
      "ordinal": 12,
      "label": "黄盖准备火船并诈降接近曹军",
      "locatorPath": "卷54/周瑜傳/赤壁火攻/準備",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "乃取蒙衝鬥艦數十艘，實以薪草，膏油灌其中，裹以帷幕，上建牙旗，先書報曹公，欺以欲降。又豫備走舸，各繫大船後，因引次俱前。曹公軍吏士皆延頸觀望，指言蓋降。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-jiangbiao-huang-gai-letter",
      "parentKey": "sgz-v54-zhou-yu-fire-attack-preparation-main",
      "nodeType": "quoted_fragment",
      "ordinal": 14,
      "label": "裴注引《江表传》黄盖诈降书与曹操答复",
      "locatorPath": "卷54/周瑜傳/赤壁火攻/裴注引江表傳/黃蓋書",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af002",
        "type": "explicit_citation",
        "text": "《江表傳》載蓋書曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "蓋受孫氏厚恩，常為將帥，見遇不薄。然顧天下事有大勢，用江東六郡山越之人，以當中國百萬之眾，眾寡不敵，海內所共見也。東方將吏，無有愚智，皆知其不可，惟周瑜、魯肅偏懷淺戇，意未解耳。今日歸命，是其實計。瑜所督領，自易摧破。交鋒之日，蓋為前部，當因事變化，效命在近。曹公特見行人，密問之，口敕曰：「但恐汝詐耳。蓋若信實，當授爵賞，超於前後也。」"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-jiangbiao-quote",
      "parentKey": "sgz-v54-zhou-yu-battle-main",
      "nodeType": "quoted_fragment",
      "ordinal": 5,
      "label": "裴注引《江表传》火攻记载",
      "locatorPath": "卷54/周瑜傳/段3/裴注引江表傳",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af002",
        "type": "explicit_citation",
        "text": "《江表傳》曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "至戰日，蓋先取輕利艦十舫，載燥荻枯柴積其中，灌以魚膏，赤幔覆之，建旌旗龍幡於艦上。時東南風急，因以十艦最著前。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-jiangbiao-fire-attack-continuation",
      "parentKey": "sgz-v54-zhou-yu-jiangbiao-quote",
      "nodeType": "quoted_fragment",
      "ordinal": 13,
      "label": "裴注引《江表传》火船发火与联军推进",
      "locatorPath": "卷54/周瑜傳/赤壁火攻/裴注引江表傳/續段",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af002",
        "type": "explicit_citation",
        "text": "《江表傳》曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "中江舉帆，蓋舉火白諸校，使眾兵齊聲大叫曰：「降焉！」操軍人皆出營立觀。去北軍二里餘，同時發火，火烈風猛，往船如箭，飛埃絕爛，燒盡北船，延及岸邊營柴。瑜等率輕銳尋繼其後，雷鼓大進，北軍大壞，曹公退走。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-retreat-main",
      "parentKey": "sgz-v54-zhou-yu",
      "nodeType": "passage",
      "ordinal": 6,
      "label": "曹军败退与南郡后续",
      "locatorPath": "卷54/周瑜傳/段4",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "蓋放諸船，同時發火。時風盛猛，悉延燒岸上營落。頃之，煙炎張天，人馬燒溺死者甚眾，軍遂敗退，還保南郡。備與瑜等復共追。曹公留曹仁等守江陵城，逕自北歸。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-zhou-yu-jiangbiao-cao-letter",
      "parentKey": "sgz-v54-zhou-yu",
      "nodeType": "quoted_fragment",
      "ordinal": 7,
      "label": "裴注引《江表传》曹操称疫病自焚退军",
      "locatorPath": "卷54/周瑜傳/裴注引江表傳/曹公書",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af002",
        "type": "explicit_citation",
        "text": "《江表傳》曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "瑜之破魏軍也，曹公曰：「孤不羞走。」後書與權曰：「赤壁之役，值有疾病，孤燒船自退，橫使周瑜虛獲此名。」"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-lu-su",
      "parentKey": "sgz-v54",
      "nodeType": "biography",
      "ordinal": 2,
      "label": "吳書·魯肅傳",
      "locatorPath": "卷54/魯肅傳",
      "layerRole": "structure"
    },
    {
      "nodeKey": "sgz-v54-lu-su-contact",
      "parentKey": "sgz-v54-lu-su",
      "nodeType": "passage",
      "ordinal": 1,
      "label": "鲁肃迎接刘备并促成遣使",
      "locatorPath": "卷54/魯肅傳/段1",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "劉表死。肅進說曰：『夫荊楚與國鄰接，水流順北，外帶江漢，內阻山陵，有金城之固，沃野萬里，士民殷富，若據而有之，此帝王之資也。今表新亡，二子素不輯睦，軍中諸將，各有彼此。加劉備天下梟雄，與操有隙，寄寓於表，表惡其能而不能用也。若備與彼協心，上下齊同，則宜撫安，與結盟好；如有離違，宜別圖之，以濟大事。肅請得奉命弔表二子，並慰勞其軍中用事者，及說備使撫表眾，同心一意，共治曹操，備必喜而從命。如其克諧，天下可定也。今不速往，恐為操所先。』權即遣肅行。到夏口，聞曹公已向荊州，晨夜兼道。比至南郡，而表子琮已降曹公，備惶遽奔走，欲南渡江。肅徑迎之，到當陽長阪，與備會，宣騰權旨，及陳江東強固，勸備與權並力。備甚歡悅。備遂到夏口，遣亮使權，肅亦反命。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-lu-su-decision",
      "parentKey": "sgz-v54-lu-su",
      "nodeType": "passage",
      "ordinal": 2,
      "label": "鲁肃与孙权议拒曹",
      "locatorPath": "卷54/魯肅傳/段2",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "會權得曹公欲東之問，與諸將議，皆勸權迎之，而肅獨不言。權起更衣，肅追於宇下。權知其意，執肅手曰：『卿欲何言？』肅對曰：『向察眾人之議，專欲誤將軍，不足與圖大事。今肅可迎操耳，如將軍，不可也。』權歎息曰：『此諸人持議，甚失孤望；今卿廓開大計，正與孤同，此天以卿賜我也。』"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-lu-su-strategy-and-return",
      "parentKey": "sgz-v54-lu-su",
      "nodeType": "passage",
      "ordinal": 4,
      "label": "鲁肃召回周瑜、助画方略与先还",
      "locatorPath": "卷54/魯肅傳/拒曹部署與戰後返吳",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "時周瑜受使至鄱陽，肅勸追召瑜還。遂任瑜以行事，以肅為贊軍校尉，助畫方略。曹公破走，肅即先還，權大請諸將迎肅。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-lu-su-hanjin-jingzhou-loan",
      "parentKey": "sgz-v54-lu-su",
      "nodeType": "quoted_fragment",
      "ordinal": 3,
      "label": "裴注引《汉晋春秋》鲁肃劝借地安刘备",
      "locatorPath": "卷54/魯肅傳/戰後經略/裴注引漢晉春秋",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af008",
        "type": "explicit_citation",
        "text": "《漢晉春秋》曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "呂範勸留備，肅曰：「不可。將軍雖神武命世，然曹公威力實重，初臨荊州，恩信未洽，宜以藉備，使撫安之。多操之敵，而自為樹黨，計之上也。」權即從之。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54-lu-meng",
      "parentKey": "sgz-v54",
      "nodeType": "biography",
      "ordinal": 3,
      "label": "吳書·呂蒙傳",
      "locatorPath": "卷54/呂蒙傳",
      "layerRole": "structure"
    },
    {
      "nodeKey": "sgz-v54-lu-meng-jiangling-aftermath",
      "parentKey": "sgz-v54-lu-meng",
      "nodeType": "passage",
      "ordinal": 1,
      "label": "吕蒙援夷陵并推进南郡",
      "locatorPath": "卷54/呂蒙傳/烏林後南郡戰事",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "是歲，又與周瑜、程普等西破曹公於烏林，圍曹仁於南郡。瑜使甘寧前據夷陵，曹仁分眾圍寧，寧困急，使使請救。諸將以兵少不足分，蒙謂瑜、普曰：「留凌公績，蒙與君行，解圍釋急，勢亦不久，蒙保公績能十日守也。」又說瑜分遣三百人柴斷險道，賊走可得其馬。瑜從之。軍到夷陵，即日交戰，所殺過半。敵夜遁去，行遇柴道，騎皆捨馬步走。兵追蹙擊，獲馬三百匹，方船載還。於是將士形勢自倍，乃渡江立屯，與相攻擊，曹仁退走。遂據南郡，撫定荊州。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v55",
      "parentKey": null,
      "nodeType": "volume",
      "ordinal": 55,
      "label": "三國志卷五十五",
