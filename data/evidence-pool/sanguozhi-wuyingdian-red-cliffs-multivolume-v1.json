    {
      "nodeKey": "sgz-v47-wuzhu",
      "parentKey": "sgz-v47",
      "nodeType": "annals",
      "ordinal": 1,
      "label": "吳書·吳主傳",
      "locatorPath": "卷47/吳主傳",
      "layerRole": "structure"
    },
    {
      "nodeKey": "sgz-v47-wuzhu-decision",
      "parentKey": "sgz-v47-wuzhu",
      "nodeType": "passage",
      "ordinal": 1,
      "label": "鲁肃接触、诸葛亮出使与孙权集团决策",
      "locatorPath": "卷47/吳主傳/段1",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "荊州牧劉表死，魯肅乞奉命吊表二子，且以觀變。肅未到，而曹公已臨其境，表子琮舉眾以降。劉備欲南濟江，肅與相見，因傳權旨，為陳成敗。備進住夏口，使諸葛亮詣權，權遣周瑜、程普等行。是時曹公新得表眾，形勢甚盛，諸議者皆望風畏懼，多勸權迎之。惟瑜、肅執拒之議，意與權同。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v47-wuzhu-jiangbiao-cao-ultimatum",
      "parentKey": "sgz-v47-wuzhu-decision",
      "nodeType": "quoted_fragment",
      "ordinal": 3,
      "label": "裴注引《江表传》曹操致孙权书",
      "locatorPath": "卷47/吳主傳/建安十三年/裴注引江表傳/曹公與權書",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af002",
        "type": "explicit_citation",
        "text": "《江表傳》載曹公與權書曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "近者奉辭伐罪，旄麾南指，劉琮束手。今治水軍八十萬眾，方與將軍會獵於吳。權得書以示群臣，莫不響震失色。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v47-wuzhu-battle",
      "parentKey": "sgz-v47-wuzhu",
      "nodeType": "passage",
      "ordinal": 2,
      "label": "赤壁战胜、追至南郡与留守江陵",
      "locatorPath": "卷47/吳主傳/段2",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "瑜、普為左右督，各領萬人，與備俱進，遇於赤壁，大破曹公軍。公燒其餘船引退，士卒飢疫，死者大半。備、瑜等復追至南郡，曹公遂北還，留曹仁、徐晃於江陵，使樂進守襄陽。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v47-wuzhu-jiangling-outcome",
      "parentKey": "sgz-v47-wuzhu",
      "nodeType": "passage",
      "ordinal": 4,
      "label": "周瑜曹仁相守与曹仁弃城",
      "locatorPath": "卷47/吳主傳/建安十四年/南郡結果",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "十四年，瑜、仁相守歲餘，所殺傷甚眾。仁委城走。權以瑜為南郡太守。劉備表權行車騎將軍，領徐州牧。備領荊州牧，屯公安。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v54",
