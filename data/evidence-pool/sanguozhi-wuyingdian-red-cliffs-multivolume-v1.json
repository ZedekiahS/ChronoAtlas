    },
    {
      "nodeKey": "sgz-v1-wudi",
      "parentKey": "sgz-v1",
      "nodeType": "annals",
      "ordinal": 1,
      "label": "魏書·武帝紀",
      "locatorPath": "卷1/武帝紀",
      "layerRole": "structure"
    },
    {
      "nodeKey": "sgz-v1-wudi-southern-campaign",
      "parentKey": "sgz-v1-wudi",
      "nodeType": "passage",
      "ordinal": 1,
      "label": "曹操南征、刘表卒与刘琮降",
      "locatorPath": "卷1/武帝紀/段1",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "秋七月，公南征劉表。八月，表卒，其子琮代，屯襄陽，劉備屯樊。九月，公到新野，琮遂降，備走夏口。公進軍江陵，下令荊州吏民，與之更始。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v1-wudi-red-cliffs-retreat",
      "parentKey": "sgz-v1-wudi",
      "nodeType": "passage",
      "ordinal": 2,
      "label": "赤壁交战、疾疫与曹军撤退",
      "locatorPath": "卷1/武帝紀/段2",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "公至赤壁，與備戰，不利。於是大疫，吏士多死者，乃引軍還。備遂有荊州、江南諸郡。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v1-wudi-shanyang-huarong",
      "parentKey": "sgz-v1-wudi-red-cliffs-retreat",
      "nodeType": "quoted_fragment",
      "ordinal": 3,
      "label": "裴注引《山阳公载记》华容退军",
      "locatorPath": "卷1/武帝紀/段2/裴注引山陽公載記",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af007",
        "type": "explicit_citation",
        "text": "《山陽公載記》曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "公船艦為備所燒，引軍從華容道步歸，遇泥濘，道不通，天又大風，悉使羸兵負草填之，騎乃得過。羸兵為人馬所蹈藉，陷泥中，死者甚眾。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v1-wudi-shanyang-huarong-assessment",
      "parentKey": "sgz-v1-wudi-shanyang-huarong",
      "nodeType": "quoted_fragment",
      "ordinal": 4,
      "label": "《山阳公载记》曹操评刘备放火稍晚",
      "locatorPath": "卷1/武帝紀/段2/裴注引山陽公載記/續段",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af007",
        "type": "explicit_citation",
        "text": "《山陽公載記》曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "軍既得出，公大喜，諸將問之，公曰：「劉備，吾儔也。但得計少晚；向使早放火，吾徒無類矣。」備尋亦放火而無所及。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v9",
      "parentKey": null,
      "nodeType": "volume",
      "ordinal": 9,
      "label": "卷九",
      "locatorPath": "卷9",
      "layerRole": "structure"
    },
    {
      "nodeKey": "sgz-v9-cao-ren",
      "parentKey": "sgz-v9",
      "nodeType": "biography",
      "ordinal": 1,
      "label": "魏書·曹仁傳",
      "locatorPath": "卷9/曹仁傳",
      "layerRole": "structure"
    },
    {
      "nodeKey": "sgz-v9-cao-ren-jiangling-defense",
      "parentKey": "sgz-v9-cao-ren",
      "nodeType": "passage",
      "ordinal": 1,
      "label": "曹仁留屯江陵与牛金解围",
      "locatorPath": "卷9/曹仁傳/江陵拒周瑜",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "從平荊州，以仁行征南將軍，留屯江陵，拒吳將周瑜。瑜將數萬眾來攻，前鋒數千人始至，仁登城望之，乃募得三百人，遣部曲將牛金逆與挑戰。賊多，金眾少，遂為所圍。長史陳矯俱在城上，望見金等垂沒，左右皆失色。仁意氣奮怒甚，謂左右取馬來，矯等共援持之。謂仁曰：「賊眾盛，不可當也。假使棄數百人何苦，而將軍以身赴之！」仁不應，遂被甲上馬，將其麾下壯士數十騎出城。去賊百餘步，迫溝，矯等以為仁當住溝上，為金形勢也，仁徑渡溝直前，衝入賊圍，金等乃得解。餘眾未盡出，仁復直還突之，拔出金兵，亡其數人，賊眾乃退。矯等初見仁出，皆懼，及見仁還，乃歎曰：「將軍真天人也！」三軍服其勇。太祖益壯之，轉封安平亭侯。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v9-cao-chun",
      "parentKey": "sgz-v9-cao-ren",
      "nodeType": "biography_section",
      "ordinal": 2,
      "label": "魏書·曹純",
      "locatorPath": "卷9/曹仁傳/弟曹純",
      "layerRole": "structure"
    },
    {
      "nodeKey": "sgz-v9-cao-chun-changban",
      "parentKey": "sgz-v9-cao-chun",
      "nodeType": "passage",
      "ordinal": 1,
      "label": "曹纯追击长坂并进降江陵",
      "locatorPath": "卷9/曹仁傳/弟曹純/長坂追擊",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "從征荊州，追劉備於長阪，獲其二女輜重，收其散卒。進降江陵，從還譙。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v32",
      "parentKey": null,
      "nodeType": "volume",
      "ordinal": 32,
      "label": "卷三十二",
      "locatorPath": "卷32",
      "layerRole": "structure"
    },
    {
      "nodeKey": "sgz-v32-xianzhu",
      "parentKey": "sgz-v32",
      "nodeType": "biography",
      "ordinal": 1,
      "label": "蜀書·先主傳",
      "locatorPath": "卷32/先主傳",
      "layerRole": "structure"
    },
    {
      "nodeKey": "sgz-v32-xianzhu-withdrawal",
      "parentKey": "sgz-v32-xianzhu",
      "nodeType": "passage",
      "ordinal": 1,
      "label": "刘琮请降与刘备南撤",
      "locatorPath": "卷32/先主傳/段1",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "曹公南征表，會表卒，子琮代立，遣使請降。先主屯樊，不知曹公卒至，至宛乃聞之，遂將其眾去。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v32-xianzhu-xiangyang-followers",
      "parentKey": "sgz-v32-xianzhu",
      "nodeType": "passage",
      "ordinal": 9,
      "label": "刘备过襄阳与民众南撤",
      "locatorPath": "卷32/先主傳/襄陽至當陽",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "過襄陽，諸葛亮說先主攻琮，荊州可有。先主曰：「吾不忍也。」乃駐馬呼琮，琮懼不能起。琮左右及荊州人多歸先主。比到當陽，眾十餘萬，輜重數千兩，日行十餘里，別遣關羽乘船數百艘，使會江陵。或謂先主曰：「宜速行保江陵，今雖擁大眾，被甲者少，若曹公兵至，何以拒之？」先主曰：「夫濟大事必以人為本，今人歸吾，吾何忍棄去！」"
        }
      ]
    },
    {
      "nodeKey": "sgz-v32-xianzhu-hanwei-surrender-notice",
      "parentKey": "sgz-v32-xianzhu-withdrawal",
      "nodeType": "quoted_fragment",
      "ordinal": 10,
      "label": "裴注引孔衍《汉魏春秋》刘琮请降与刘备应对",
      "locatorPath": "卷32/先主傳/劉琮請降/裴注引漢魏春秋",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af02a",
        "type": "explicit_citation",
        "text": "孔衍《漢魏春秋》曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "劉琮乞降，不敢告備。備亦不知，久之乃覺，遣所親問琮。琮令宋忠詣備宣旨。是時曹公在宛，備乃大驚駭，謂忠曰：「卿諸人作事如此，不早相語，今禍至方告我，不亦太劇乎！」引刀向忠曰：「今斷卿頭，不足以解忿，亦恥大丈夫臨別復殺卿輩！」遣忠去，乃呼部曲議。或勸備劫將琮及荊州吏士徑南到江陵，備答曰：「劉荊州臨亡託我以孤遺，背信自濟，吾所不為，死何面目以見劉荊州乎！」"
        }
      ]
    },
    {
      "nodeKey": "sgz-v32-xianzhu-changban",
      "parentKey": "sgz-v32-xianzhu",
      "nodeType": "passage",
      "ordinal": 2,
      "label": "长坂追击、汉津会合与抵达夏口",
      "locatorPath": "卷32/先主傳/段2",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "曹公以江陵有軍實，恐先主據之，乃釋輜重，輕軍到襄陽。聞先主已過，曹公將精騎五千急追之，一日一夜行三百餘里，及於當陽之長阪。先主棄妻子，與諸葛亮、張飛、趙雲等數十騎走，曹公大獲其人眾輜重。先主斜趨漢津，適與羽船會，得濟沔，遇表長子江夏太守琦眾萬餘人，與俱到夏口。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v32-xianzhu-alliance-battle",
      "parentKey": "sgz-v32-xianzhu",
      "nodeType": "passage",
      "ordinal": 3,
      "label": "诸葛亮出使、联军形成与赤壁追击",
      "locatorPath": "卷32/先主傳/段3",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "先主遣諸葛亮自結於孫權，權遣周瑜、程普等水軍數萬，與先主並力，與曹公戰於赤壁，大破之，焚其舟船。先主與吳軍水陸並進，追到南郡，時又疾疫，北軍多死，曹公引歸。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v32-xianzhu-aftermath",
      "parentKey": "sgz-v32-xianzhu",
      "nodeType": "passage",
      "ordinal": 4,
      "label": "刘备南征荆南四郡",
      "locatorPath": "卷32/先主傳/段4",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "先主表琦為荊州刺史，又南征四郡。武陵太守金旋、長沙太守韓玄、桂陽太守趙範、零陵太守劉度皆降。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v32-xianzhu-jiangbiao-lu-su",
      "parentKey": "sgz-v32-xianzhu-changban",
      "nodeType": "quoted_fragment",
      "ordinal": 5,
      "label": "裴注引《江表传》鲁肃接触刘备",
      "locatorPath": "卷32/先主傳/段2/裴注引江表傳",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af002",
        "type": "explicit_citation",
        "text": "《江表傳》曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "孫權遣魯肅吊劉表二子，並令與備相結。肅未至而曹公已濟漢津。肅故進前，與備相遇於當陽。因宣權旨，論天下事勢，致殷勤之意。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v32-xianzhu-jiangbiao-fankou-force",
      "parentKey": "sgz-v32-xianzhu-alliance-battle",
      "nodeType": "quoted_fragment",
      "ordinal": 6,
      "label": "裴注引《江表传》樊口会见与三万兵力",
      "locatorPath": "卷32/先主傳/段3/裴注引江表傳/樊口會見",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af002",
        "type": "explicit_citation",
        "text": "《江表傳》曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "備從魯肅計，進住鄂縣之樊口。諸葛亮詣吳未還，備聞曹公軍下，恐懼，日遣邏吏於水次候望權軍。吏望見瑜船，馳往白備，備曰：「何以知之非青徐軍邪？」吏對曰：「以船知之。」備遣人慰勞之。瑜曰：「有軍任，不可得委署，儻能屈威，誠副其所望。」備謂關羽、張飛曰：「彼欲致我，我今自結託於東而不往，非同盟之意也。」乃乘單舸往見瑜，問曰：「今拒曹公，深為得計。戰卒有幾？」瑜曰：「三萬人。」備曰：「恨少。」瑜曰：「此自足用，豫州但觀瑜破之。」備欲呼魯肅等共會語，瑜曰：「受命不得妄委署，若欲見子敬，可別過之。又孔明已俱來，不過三兩日到也。」備雖深愧異瑜，而心未許之能必破北軍也，故差池在後，將二千人與羽、飛俱，未肯係瑜，蓋為進退之計也。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v32-xianzhu-jiangbiao-gongan-jingzhou",
      "parentKey": "sgz-v32-xianzhu-aftermath",
      "nodeType": "quoted_fragment",
      "ordinal": 7,
      "label": "裴注引《江表传》公安立营与借荆州",
      "locatorPath": "卷32/先主傳/段3/裴注引江表傳/公安與借荊州",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af002",
        "type": "explicit_citation",
        "text": "《江表傳》曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "周瑜為南郡太守，分南岸地以給備。備別立營於油江口，改名為公安。劉表吏士見從北軍，多叛來投備。備以瑜所給地少，不足以安民，（後）〔復〕從權借荊州數郡。"
        }
      ]
    },
    {
      "nodeKey": "sgz-v32-xianzhu-xiandi-shu-strategy",
      "parentKey": "sgz-v32-xianzhu",
      "nodeType": "quoted_fragment",
      "ordinal": 8,
      "label": "裴注引《献帝春秋》孙刘共取蜀之议",
      "locatorPath": "卷32/先主傳/戰後經略/裴注引獻帝春秋",
      "layerRole": "quoted_fragment",
      "attribution": {
        "workId": "019f24ee-4c8f-7a20-8b5b-8795d01af009",
        "type": "explicit_citation",
        "text": "《獻帝春秋》曰"
      },
      "layers": [
        {
          "kind": "quotation",
          "language": "lzh",
          "script": "Hant",
          "text": "孫權欲與備共取蜀，遣使報備曰：「米賊張魯居王巴、漢，為曹操耳目，規圖益州。劉璋不武，不能自守。若操得蜀，則荊州危矣。今欲先攻取璋，進討張魯，首尾相連，一統吳、楚，雖有十操，無所憂也。」備欲自圖蜀，拒答不聽，曰：「益州民富彊，土地險阻，劉璋雖弱，足以自守。張魯虛偽，未必盡忠於操。今暴師於蜀、漢，轉運於萬里，欲使戰克攻取，舉不失利，此吳起不能定其規，孫武不能善其事也。曹操雖有無君之心，而有奉主之名，議者見操失利於赤壁，謂其力屈，無復遠志也。今操三分天下已有其二，將欲飲馬於滄海，觀兵於吳會，何肯守此坐須老乎？今同盟無故自相攻伐，借樞於操，使敵承其隙，非長計也。」權不聽，遣孫瑜率水軍住夏口。備不聽軍過，謂瑜曰：「汝欲取蜀，吾當被髮入山，不失信於天下也。」使關羽屯江陵，張飛屯秭歸，諸葛亮據南郡，備自住孱陵。權知備意，因召瑜還。"
        }
      ]
    },
