      "parentKey": "hhs-v74b",
      "nodeType": "biography",
      "ordinal": 1,
      "label": "袁紹劉表列傳第六十四下·劉表",
      "locatorPath": "卷74下/劉表列傳",
      "layerRole": "structure"
    },
    {
      "nodeKey": "hhs-v74b-liu-biao-surrender",
      "parentKey": "hhs-v74b-liu-biao",
      "nodeType": "passage",
      "ordinal": 1,
      "label": "刘琮投降、刘备奔夏口与赤壁结果",
      "locatorPath": "卷74下/劉表列傳/建安十三年",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "及操軍到襄陽，琮舉州請降，劉備奔夏口。操後敗於赤壁，劉備表琦為荊州刺史。"
        }
      ]
    }
