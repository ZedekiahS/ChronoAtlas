      "nodeType": "biographical_chronicle",
      "ordinal": 1,
      "label": "劉先主志",
      "locatorPath": "卷6/劉先主志",
      "layerRole": "structure"
    },
    {
      "nodeKey": "hygz-v6-liu-biao-death",
      "parentKey": "hygz-v6-liu-xianzhu",
      "nodeType": "passage",
      "ordinal": 1,
      "label": "刘表去世、刘琮请降与刘备南撤",
      "locatorPath": "卷6/劉先主志/建安十三年/段1",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "十三年，表卒，少子琮襲位。曹公南征，琮遣使請降。先主屯樊，不知曹公卒至。至宛，先主乃知，遂將其眾去。"
        }
      ]
    },
    {
      "nodeKey": "hygz-v6-changban-alliance",
      "parentKey": "hygz-v6-liu-xianzhu",
      "nodeType": "passage",
      "ordinal": 2,
      "label": "长坂败退、汉津会合与诸葛亮求援",
      "locatorPath": "卷6/劉先主志/建安十三年/段2",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "比到當陽，眾十餘萬人，車數千兩，日行十餘里，別遣關侯乘船會江陵。公以江陵有軍實，恐先主據之，乃釋輜重，以輕騎五千追先主，一日一夜行三百里，及於當陽之長坂。先主棄妻子，與諸葛亮、張飛等數十騎走。先主斜趣漢津，適與侯船會。亮曰：事急矣，請奉命求救於孫將軍。"
        }
      ]
    },
    {
      "nodeKey": "hygz-v6-red-cliffs",
      "parentKey": "hygz-v6-liu-xianzhu",
      "nodeType": "passage",
      "ordinal": 3,
      "label": "孙权派军、赤壁大破曹军与曹操北归",
      "locatorPath": "卷6/劉先主志/建安十三年/段3",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "孫將軍時權軍柴桑，既服先主大名，又悅亮奇雅，即遣周瑜、程普水軍三萬助先主拒曹公，大破公軍於赤壁，焚其舫舟。公引軍北歸。"
        }
      ]
    },
    {
      "nodeKey": "hygz-v6-jingzhou-aftermath",
      "parentKey": "hygz-v6-liu-xianzhu",
      "nodeType": "passage",
      "ordinal": 4,
      "label": "刘备南平四郡与治公安",
      "locatorPath": "卷6/劉先主志/建安十三至十四年/段4",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "先主以劉表長子江夏太守琦為荊州刺史。先主南平四郡，武陵太守金旋、長沙太守韓玄、桂陽太守趙範、零陵太守劉度皆降。會琦病死，先主領荊州牧，治公安。"
        }
      ]
    }
  ]
