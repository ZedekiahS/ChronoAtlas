    {
      "nodeKey": "songshu-v37-jiangxia-name-layers",
      "parentKey": "songshu-v37-yingzhou",
      "nodeType": "commandery_entry",
      "ordinal": 1,
      "label": "江夏郡的沙羡、沙阳与蒲圻沿革",
      "locatorPath": "卷37/州郡志三/郢州/江夏太守",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "江夏太守，漢高帝立，本屬荊州。永初郡國及何志並治安陸，此後治夏口。又有安陸、曲陵，曲後別郡。領縣七，戶五千七十二，口二萬三千八百一十。汝南侯相，本沙羡土，晉末汝南郡民流寓夏口，因立為汝南縣。沙羡令，漢舊縣，吳省。晉武太康元年復立，治夏口。孝武太元三年，省併沙陽，後以其地為汝南實土。沙陽男相，二漢舊縣，本名沙羡，屬武昌，晉武帝太康元年更名，又立沙羡，而沙陽徙今所治。文帝元嘉十六年度巴陵，孝武孝建元年度江夏。蒲圻男相，晉武帝太康元年立。本屬長沙，文帝元嘉十六年度巴陵，孝武孝建元年度江夏。"
        }
      ]
    },
    {
      "nodeKey": "songshu-v37-baling-puqi",
      "parentKey": "songshu-v37-yingzhou",
      "nodeType": "commandery_entry",
      "ordinal": 2,
      "label": "巴陵郡所见蒲圻改属",
      "locatorPath": "卷37/州郡志三/郢州/巴陵太守",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "巴陵太守，文帝元嘉十六年，分長沙之巴陵、蒲圻、下雋，江夏之沙陽四縣立，屬湘州；孝武孝建元年，割南郡之監利、州陵度江夏，屬郢州。"
        }
      ]
    },
    {
      "nodeKey": "songshu-v37-wuchang",
      "parentKey": "songshu-v37-yingzhou",
      "nodeType": "commandery_entry",
      "ordinal": 3,
      "label": "武昌郡与鄂县名称沿革",
      "locatorPath": "卷37/州郡志三/郢州/武昌太守",
      "layerRole": "main_text",
      "layers": [
        {
          "kind": "diplomatic",
          "language": "lzh",
          "script": "Hant",
          "text": "武昌太守，晉起居注，太康元年，改江夏為武昌郡。領縣三，戶二千五百四十六，口一萬一千四百一十一。武昌侯相，魏文帝黃初二年，孫權改鄂為武昌。陽新侯相，吳立。鄂令，漢舊縣，屬江夏。吳改鄂為武昌，晉武帝太康元年，復立鄂縣，而武昌如故。"
        }
      ]
    }
  ]
